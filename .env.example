# Copie este arquivo para .env e troque o valor de SECRET_KEY.
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Assistente Financeiro: sem a chave, o Assistente fica indisponível e o
# restante do sistema funciona.
OPENAI_API_KEY=
# A OpenAI desliga o gpt-5-mini em 11/12/2026. Depois dessa data, o Assistente
# para de funcionar até AI_MODEL_NAME ser trocado por outro modelo (substituto
# indicado: gpt-5.6-terra). A troca não exige alteração de código.
# O gpt-5-mini segue como padrão por decisão do responsável (item I-01 do PRD).
AI_MODEL_NAME=gpt-5-mini
